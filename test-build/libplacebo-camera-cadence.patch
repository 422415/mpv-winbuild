+// AJN experiment, preserving the public render-parameter ABI. Call before
+// pl_render_image_mix; offset uses source-frame units relative to presentation.
+// The caller requests a queue radius of 2 while this is enabled.
+#define PL_HAVE_AJN_CAMERA_CADENCE 1
+PL_API void pl_renderer_set_camera_cadence(pl_renderer rr, bool enabled, float offset);
+
+// Separate experiment: sample coherent rigid pans at presentation time while
+// retaining the current source drawing. Requires an integer display cadence.
+#define PL_HAVE_AJN_CAMERA_PAN_SMOOTHING 1
+PL_API void pl_renderer_set_camera_pan_smoothing(pl_renderer rr, bool enabled);
+
 // Returns current renderer state, see pl_render_errors.
